# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example (placeholders/descriptions, no secrets) is tracked.

# REQUIRED — the app always calls the real CAS e-signing API (there is no
# mock mode). No default is hardcoded in source on purpose — see
# Rule/RULES.md ("không hardcode default cho endpoint/key nội bộ"). A
# missing value fails loudly at startup instead of silently falling back to
# anything.
CAS_ESIGN_BASE_URL=
CAS_ESIGN_CLIENT_ID=
CAS_ESIGN_API_KEY=

# Trusted Root CA certificates are bundled in lib/trustStore/roots/ (public
# data, not a secret — see that folder's README) instead of an env var here.
# To trust an additional root, add a file there; never delete an existing
# one just because a newer generation was added (see the README's
# append-only policy — a document signed under an older root must stay
# verifiable forever).

# OPTIONAL — USB-token signing through the local KysoQR Agent. Ed25519 key
# pair (base64 DER, one line each) used to sign the short-lived tickets the
# browser hands to the agent (POST /api/agent-ticket). Only the server reads
# the PRIVATE key; the PUBLIC key is kept here for reference and goes into
# the agent's own .env (PUBLIC_KEY_HAND_SHAKE_AGENT). Never expose either
# through a NEXT_PUBLIC_* variable. Empty = the ticket endpoint answers 503
# and the rest of the app works unchanged.
PRIVATE_KEY_HAND_SHAKE_AGENT=
PUBLIC_KEY_HAND_SHAKE_AGENT=

# OPTIONAL — where the local KysoQR Agent listens on the USER's machine
# (http://127.0.0.1:<KYSOQR_AGENT_PORT of the agent>). Public, not a secret:
# the browser calls it directly. Inlined at build time. Empty = the "USB
# Token" signing option is not shown at all.
NEXT_PUBLIC_KYSOQR_AGENT_URL=
