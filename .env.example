# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example (placeholders/descriptions, no secrets) is tracked.

# REQUIRED — the app always calls the real CAS e-signing API (there is no
# mock mode). No default is hardcoded in source on purpose — see
# Rule/RULES.md ("không hardcode default cho endpoint/key nội bộ"). A
# missing value fails loudly at startup instead of silently falling back to
# anything.
CAS_ESIGN_BASE_URL=
CAS_ESIGN_CLIENT_ID=
CAS_ESIGN_API_KEY=

# The public origin of this site: scheme + host, no path, no trailing slash
# (e.g. https://kysoqr.example). Redirects built by proxy.ts -- and the Origin
# check on the VNeID routes -- use it instead of request headers, which a caller
# can forge. Set it in production (also as a Runtime variable on Cloudflare);
# leave it empty for local development.
APP_ORIGIN=

# Which request header carries the client's real IP, for rate limiting.
# - Behind nginx on a VPS: x-real-ip (deploy/nginx.conf.example overwrites it
#   from the TCP peer on every request, so a client cannot choose it).
# - Leave EMPTY on the Cloudflare Worker: Cloudflare's own CF-Connecting-IP is
#   used there. Do NOT leave it empty on a VPS: without it the limiter trusts
#   CF-Connecting-IP / X-Forwarded-For, which any client can send directly.
TRUSTED_IP_HEADER=

# Trusted Root CA certificates are bundled in lib/trustStore/roots/ (public
# data, not a secret — see that folder's README) instead of an env var here.
# To trust an additional root, add a file there; never delete an existing
# one just because a newer generation was added (see the README's
# append-only policy — a document signed under an older root must stay
# verifiable forever).

# --- VNeID signing (CMC CSign Gateway) -- optional ----------------------------
# Leave these empty and the VNeID routes answer VNEID_NOT_CONFIGURED; CAS keeps
# working. VPS only: it needs node:sqlite and a writable disk (not Cloudflare).
#
# Required to sign (only these three):
# CSign base URL, https only. Use the host CMC gave you; the UAT gateway that
# answers today is https://csign-uat.cmccs.vn (the API spec mentions another).
# Check the setup without signing anything: npm run vneid:check -- <CCCD>
CMC_CA_HOST=
# CSign organization account (the /api/auth/login credentials).
CMC_CA_USERNAME=
CMC_CA_PASSWORD=
#
# Optional (the database is created on server start, see instrumentation.ts):
# SQLite file [./.data/vneid.sqlite]. VPS: /var/lib/kysoqr/vneid.sqlite
# The store key (HMAC of CCCD numbers, AES-GCM of saved data) is created once
# in vneid.key next to it -- nothing to set. Keep that folder private and do
# not delete the key while a signing is in progress.
VNEID_DB_PATH=
#
# Webhook receiver (optional: without it the status is fetched with
# query-status). The webhook URL itself is registered at CSign, not here:
# <APP_ORIGIN>/api/vneid/webhook. Set both or neither.
# organizationId from GET /api/organization/webhooks:
CSIGN_ORGANIZATION_ID=
# The `key` returned once by POST /api/organization/webhooks (whsec_...).
CSIGN_WEBHOOK_SECRET=
# The old key while rotating to a new one; empty otherwise.
CSIGN_WEBHOOK_SECRET_PREVIOUS=
#
# Tuning (defaults in brackets):
# Who may use VNeID (signing, certificate lookup, registration, /vneid): comma-separated
# IPs and CIDR ranges, e.g. 203.0.113.5,198.51.100.0/24. Empty: everyone (local).
# Needs TRUSTED_IP_HEADER (x-real-ip behind nginx); without it VNeID closes to everyone.
VNEID_TRUSTED_IPS=
# sign requests and certificate lookups per day, each, for the whole service [5000]
VNEID_DAILY_CAP=
# days the audit trail is kept [90]
VNEID_AUDIT_DAYS=
# true = the user types back a 6-character code shown on VNeID [false].
# Only turn on after checking VNeID shows the document name.
VNEID_REQUIRE_CODE=
# RFC 3161 timestamp authority for the signing time [http://timestamp.digicert.com].
# off = sign without a timestamp.
TSA_URL=
# Asked when TSA_URL fails or answers something unusable [http://timestamp.sectigo.com].
# off = no second TSA.
TSA_FALLBACK_URL=
# off = never ask CSign query-status: signing results then arrive by webhook
# only (needs CSIGN_ORGANIZATION_ID + CSIGN_WEBHOOK_SECRET). Only for checking
# that the webhook works; leave empty otherwise [on].
VNEID_QUERY_STATUS=