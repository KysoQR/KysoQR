{
  "name": "kysoqr",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "KysoQR / XSign — PDF e-signing + verification. Single Next.js app, stateless, no database.",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generateCertManifest.js",
    "build": "next build",
    "gen:certs": "node scripts/generateCertManifest.js",
    "vneid:check": "node scripts/dev/vneid-check.mjs",
    "pdf:sign-check": "node scripts/dev/pdf-sign-check.mjs",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "cf:build": "node scripts/patchOpenNextOtelAlias.js && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@iconify/react": "6.0.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@scalar/api-reference-react": "0.9.82",
    "asn1js": "^3.0.10",
    "i18next": "26.4.2",
    "next": "16.4.2",
    "node-forge": "1.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pkijs": "^3.4.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.13",
    "uuid": "14.0.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/uuid": "11.0.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "gifenc": "^1.0.3",
    "prettier": "3.9.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.5",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  }
}
