# --- khối này nằm NGOÀI `server {}`: nó phải ở mức `http {}` -----------------------
# File trong /etc/nginx/sites-enabled/ được include bên trong `http {}` của
# nginx.conf nên đặt ở đây là hợp lệ. Hai vùng nhớ đếm request theo IP, dùng cho
# giới hạn tốc độ của các endpoint ký bằng VNeID ở dưới.
limit_req_zone $binary_remote_addr zone=kysoqr_vneid_sign:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=kysoqr_vneid_status:10m rate=180r/m;
limit_req_status 429;

server {
    listen 80;
    server_name <your-domain>;

    # Nginx mặc định chỉ cho phép body 1MB — nhỏ hơn hẳn giới hạn thật của
    # app (20MB cho verify/upload, xem MAX_UPLOAD_SIZE_MB trong
    # components/signing/constants.ts; 10MB riêng cho ký/CAS, xem
    # app/api/sign/request/route.ts). Thiếu dòng này, upload file lớn hơn
    # 1MB sẽ bị Nginx tự chặn bằng trang lỗi HTML riêng (413) TRƯỚC KHI tới
    # được app — browser sẽ thấy lỗi rất khó hiểu vì app luôn trả JSON.
    # Đặt cao hơn 20MB một chút (25m) để chừa dư cho overhead của multipart
    # (boundary, header field), tránh vừa sát mép lại bị chặn nhầm.
    client_max_body_size 25m;

    # --- IP thật của người dùng -------------------------------------------------
    # App giới hạn tốc độ theo IP (biến TRUSTED_IP_HEADER=x-real-ip trong .env).
    # Header đó PHẢI do nginx tự đặt, không bao giờ lấy từ client:
    #  - Nếu site đứng sau Cloudflare, mọi kết nối TCP tới nginx đều đến từ IP của
    #    Cloudflare; IP người dùng nằm trong CF-Connecting-IP. nginx chỉ tin
    #    header này khi kết nối đến từ đúng các dải dưới đây (còn kết nối trực
    #    tiếp thì header bị bỏ qua và $remote_addr giữ nguyên là IP kết nối).
    #  - Danh sách lấy từ https://www.cloudflare.com/ips-v4 và /ips-v6 — nhớ cập
    #    nhật khi Cloudflare đổi.
    #  - Site không dùng Cloudflare thì các dòng này vô hại, giữ nguyên.
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;

    # Mọi location bên dưới dùng chung các header này (location nào tự khai báo
    # proxy_set_header riêng thì mất hết phần thừa kế — đừng làm vậy).
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Xoá bản do client tự gửi: app không đọc nó khi đã đặt TRUSTED_IP_HEADER.
    proxy_set_header CF-Connecting-IP "";

    # --- chặn rác dò quét -----------------------------------------------------------
    # App không dùng Server Action của Next.js. Mọi request mang header
    # Next-Action là bot dò lỗ hổng (log hiện "Server Reference ID ... Received x").
    # 444 = nginx đóng kết nối, không trả gì.
    if ($http_next_action) { return 444; }

    # File ẩn (.env, .git, .DS_Store...) không bao giờ là thứ cần phục vụ.
    # Chừa .well-known cho certbot.
    location ~ /\.(?!well-known/) { return 404; }

    # --- ký bằng VNeID ----------------------------------------------------------------
    # Tải file lên: giới hạn riêng theo IP, body tối đa 11MB (file 10MB + multipart).
    location ~ ^/api/vneid/(sign|finalize)/?$ {
        limit_req zone=kysoqr_vneid_sign burst=20 nodelay;
        client_max_body_size 11m;
        proxy_pass http://127.0.0.1:3000;
    }

    # Trình duyệt hỏi trạng thái (vài giây một lần): body chỉ vài chục byte.
    location ~ ^/api/vneid/status/?$ {
        limit_req zone=kysoqr_vneid_status burst=60 nodelay;
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:3000;
    }

    # CSign gọi vào đây (webhook). Chỉ nhận POST, body nhỏ. Nếu site đứng sau
    # Cloudflare, thêm luật WAF "Skip" (bot / rate limit) cho đúng đường dẫn này,
    # kẻo Cloudflare chặn nhầm request máy-với-máy của CSign.
    location = /api/vneid/webhook {
        limit_except POST { deny all; }
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:3000;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
    }
}
